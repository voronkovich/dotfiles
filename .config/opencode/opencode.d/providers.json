{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "neuraldeep",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "teamorouter",
      "effect": "allow"
    }
  ],
  "providers": {
    "aihubmix": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "{file:~/.secrets/api/aihubmix}"
      },
      "whitelist": [
        "coding-glm-5-free",
        "coding-glm-5.1-free",
        "coding-minimax-m2.7-free",
        "gpt-4.1-free",
        "gpt-4o-free",
        "kimi-for-coding-free"
      ]
    },
    "kilo": {
      "package": "@opencode/ai/providers/openai-compatible",
      "whitelist": [
        "kilo-auto/free"
      ]
    },
    "neuraldeep": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "NeuralDeep",
      "env": [
        "NEURALDEEP_API_KEY"
      ],
      "settings": {
        "baseURL": "https://api.neuraldeep.ru/v1",
        "apiKey": "{file:~/.secrets/api/ai/neuraldeep}"
      },
      "models": {
        "qwen3.6-fp8": {
