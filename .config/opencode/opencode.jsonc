/*
 * Free Tier:
 *
 * https://www.askcodi.com/models
 * https://aihubmix.com/models
 * https://kilo.ai/docs/code-with-ai/agents/free-and-budget-models#kilo-gateway-free-models
 * https://opencode.ai/docs/zen/#pricing
 * https://docs.z.ai/guides/overview/pricing#text-models-2
 */
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "zai/glm-4.5-flash",
  "small_model": "qwen3.6-fp8-noreason",
  "enabled_providers": [
    "aihubmix",
    "kilo",
    "neuraldeep",
    "neurly",
    "opencode",
    "teamorouter",
    "zai",
  ],
  "providers": {
    "aihubmix": {
      "package": "@opencode/ai/providers/openai-compatible",
      "whitelist": [
        "coding-glm-5-free",
        "coding-glm-5.1-free",
        "coding-minimax-m2.7-free",
        "gpt-4.1-free",
        "gpt-4o-free",
        "kimi-for-coding-free",
      ]
    },
    "kilo": {
      "package": "@opencode/ai/providers/openai-compatible",
      "whitelist": [
        "kilo-auto/free"
      ]
    },
    "neuraldeep": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "NeuralDeep",
      "env": [
        "NEURALDEEP_API_KEY"
      ],
      "settings": {
        "baseURL": "https://api.neuraldeep.ru/v1",
      },
      "models": {
        "qwen3.6-fp8": {
          // https://neuraldeep.ru/models/qwen3-6-fp8
          "name": "NeuralDeep: Qwen 3.6 FP8",
          "tool_call": true,
          "limit": {
            "context": 46112,
            "output": 131072
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "qwen3.6-fp8-noreason": {
          // https://neuraldeep.ru/models/qwen3-6-fp8-noreason
          "name": "NeuralDeep: Qwen 3.6 FP8 No Reason",
          "tool_call": true,
          "limit": {
            "context": 46112,
            "output": 131072
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
      }
    },
    "neurly": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Neurly",
      "env": [
        "NEURLY_API_KEY"
      ],
      "settings": {
        "baseURL": "https://neurly.ru/v1",
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          // https://neurly.ru/models/deepseek/deepseek-v4-flash
          "name": "Neurly: DeepSeek V4 Flash",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          // https://neurly.ru/models/deepseek/deepseek-v4-flash-0731
          "name": "Neurly: DeepSeek V4 Flash 0731",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "openai/gpt-5-nano": {
          // https: //neurly.ru/models/deepseek/deepseek-v4-flash-0731
          "name": "Neurly: GPT-5 Nano",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "deepseek/deepseek-v4.1-flash": {
          // https://neurly.ru/models/deepseek/deepseek-v4.1-flash
          "name": "Neurly: DeepSeek V4.1 Flash",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "deepseek/deepseek-v4.1-flash-1017": {
          // https://neurly.ru/models/deepseek/deepseek-v4.1-flash-1017
          "name": "Neurly: DeepSeek V4.1 Flash 1017",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "qwen/qwen3.7-flash": {
          // https://neurly.ru/models/qwen/qwen3.7-flash
          "name": "Neurly: Qwen 3.7 Flash",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 65536,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "z-ai/glm-5.3-flash": {
          // https://neurly.ru/models/z-ai/glm-5.3-flash
          "name": "Neurly: GLM 5.3 Flash",
          "tool_call": true,
          "limit": {
            "context": 1310720,
            "output": 131072,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
      },
    },
    "teamorouter": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "TeamoRouter",
      "env": [
        "TEAMOROUTER_API_KEY"
      ],
      "settings": {
        "baseURL": "https://api.teamorouter.com/v1",
      },
      "models": {
        "deepseek-flash-free": {
          // https://teamorouter.com/models/deepseek-flash-free
          "name": "TeamoRouter: DeepSeek Flash Free",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        }
      }
    },
    "zai": {
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "ZAI_API_KEY"
      ],
      "settings": {},
      "whitelist": [
        "glm-4.7-flash",
        "glm-4.5-flash",
      ]
    },
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "disabled": false,
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
    },
  },
}
