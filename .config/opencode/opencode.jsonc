/*
* Free Tier:
*
* https://www.askcodi.com/models
* https://aihubmix.com/models
* https://kilo.ai/docs/code-with-ai/agents/free-and-budget-models#kilo-gateway-free-models
* https://opencode.ai/docs/zen/#pricing
*/
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "zai/glm-4.7-flash",
  "small_model": "zai/glm-4.5-flash",
  "enabled_providers": [
    "aihubmix",
    "kilo",
    "neuraldeep",
    "neurly",
    "opencode",
    "zai",
  ],
  "provider": {
    "aihubmix": {
      "whitelist": [
        "coding-glm-5-free",
        "coding-glm-5.1-free",
        "coding-minimax-m2.7-free",
        "gpt-4.1-free",
        "gpt-4o-free",
        "kimi-for-coding-free",
      ]
    },
    "kilo": {
      "whitelist": [
        "kilo-auto/free"
      ]
    },
    "neuraldeep": {
      "name": "Neuraldeep",
      "options": {
        "baseURL": "https://api.neuraldeep.ru/v1",
        "apiKey": "{env:NEURALDEEP_API_KEY}",
      },
      "models": {
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 46112,
            "output": 131072
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
      }
    },
    "neurly": {
      "name": "Neurly",
      "options": {
        "baseURL": "https://neurly.ru/v1",
        "apiKey": "{env:NEURLY_API_KEY}",
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          // https://neurly.ru/models/deepseek/deepseek-v4-flash
          "name": "DeepSeek: DeepSeek V4 Flash",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
        "z-ai/glm-5.3-flash": {
          // https://neurly.ru/models/z-ai/glm-5.3-flash
          "name": "Z.ai: GLM 5.3 Flash",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1310720,
            "output": 131072,
          },
          "cost": {
            "input": 0,
            "output": 0,
          }
        },
      },
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "docx-mcp": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "--from",
        "docx-mcp-server==0.7.4",
        "--with",
        "mcp==1.29.0",
        "docx-mcp-server"
      ]
    },
    "word-mcp-live": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "--from",
        "word-mcp-live",
        "word_mcp_server",
      ]
    },
  },
  "plugin": [
    "context-mode@1.0.169"
  ]
}
