; http://editorconfig.org

root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,ts,json,jsonc}]
indent_size = 2

[composer.json]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[**/.github/workflows/*.{yml,yaml}]
indent_size = 2
